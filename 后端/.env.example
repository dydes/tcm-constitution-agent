# DeepSeek API 配置示例
# 复制此文件为 .env，然后填入你自己的真实Key
# .env 文件不会被提交到GitHub（已在.gitignore中配置）

# 你的DeepSeek API Key（必填）
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-在这里填入你的真实key

# DeepSeek API地址（一般不用改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型（deepseek-chat 或 deepseek-reasoner）
DEEPSEEK_MODEL=deepseek-chat
